# Copie estes nomes para Environment no Render. NUNCA coloque valores reais em arquivos do GitHub.
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_VERIFY_TOKEN=
# Senha do painel: invente uma frase longa. O painel manda esse valor no cabeçalho x-admin-key.
ADMIN_KEY=
# Endereço do Postgres do Render (Internal Database URL)
DATABASE_URL=
# Endereço público do serviço, ex.: https://achadinhos-ig.onrender.com
# (no Render, se ficar vazio, o serviço usa o endereço automático RENDER_EXTERNAL_URL)
PUBLIC_URL=
# Opcional
IG_API_VERSION=v26.0
